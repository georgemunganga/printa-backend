# .env.example

# App
APP_PORT=8080
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=printa
DB_SSL_MODE=disable

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRATION=24h

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://api.printa.co.zm/api/v1/auth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT_URL=https://vendor.printa.co.zm/auth/google/callback
GOOGLE_OAUTH_ALLOWED_REDIRECTS=https://vendor.printa.co.zm/auth/google/callback,https://app.printa.co.zm/auth/google/callback,http://localhost:5173/auth/google/callback,http://127.0.0.1:5173/auth/google/callback
GOOGLE_OAUTH_VENDOR_REDIRECTS=https://vendor.printa.co.zm/auth/google/callback,http://localhost:5173/auth/google/callback,http://127.0.0.1:5173/auth/google/callback

# Payment & Billing
PRINTA_PAYMENT_DEFAULT_CURRENCY=ZMW
PRINTA_PAYMENT_ENABLED_GATEWAYS=mtn_momo,airtel_money
PRINTA_BILLING_JOB_SCHEDULE="@monthly" # Cron expression for billing job

# MTN Mobile Money
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=

# Airtel Money
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@printa.co.zm
SMTP_FROM_NAME=Printa Admin

# SMS (Africa's Talking)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
